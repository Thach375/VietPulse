# Copy to infra/.env and fill every required blank with actual operator inputs.
# Format: literal KEY=value, no quotes, substitutions, exports, or inline comments.
# This file contains no credentials. Keep private keys outside the repository.

# Supported hosts: Ubuntu 22.04 or 24.04 LTS, named vp-node-1 through vp-node-4.
# IPs must be unique private IPv4 addresses reachable from the operator machine.
# STORAGE_PATH must already exist on the filesystem intended for local-path PVCs.
# Do not guess a mount path or substitute the Windows disk's advertised capacity.
NODE1_IP=
NODE1_USER=
NODE1_STORAGE_PATH=
NODE2_IP=
NODE2_USER=
NODE2_STORAGE_PATH=
NODE3_IP=
NODE3_USER=
NODE3_STORAGE_PATH=
NODE4_IP=
NODE4_USER=
NODE4_STORAGE_PATH=

# REQUIRED choice: ufw-rules (UFW active) or ufw-disabled (trusted LAN only).
# Preflight reads the current policy; it never enables, disables, or edits UFW.
FIREWALL_POLICY=

# Optional shared SSH port and absolute private-key path; an SSH agent also works.
# Host keys must already be verified and enrolled in the operator's known_hosts.
SSH_PORT=22
SSH_IDENTITY_FILE=
